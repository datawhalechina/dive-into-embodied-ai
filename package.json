{
  "name": "dive-into-embodied-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "node scripts/with-build-lock.mjs node_modules/@docusaurus/core/bin/docusaurus.mjs build",
    "install:locked": "node scripts/with-build-lock.mjs --npm-ci",
    "check:build-lock": "node --test scripts/with-build-lock.test.mjs",
    "check:local-build": "node --test scripts/local-build.test.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "check:i18n": "node scripts/check-i18n.cjs",
    "check:page-markdown": "node scripts/check-page-markdown.mjs",
    "check:doc-assets": "node scripts/check-doc-assets.cjs",
    "check:math-refs": "node scripts/check-math-refs.cjs",
    "check:doc-sidebars": "node scripts/check-doc-sidebars.cjs",
    "check:playgrounds": "node scripts/check-playgrounds.cjs",
    "check:quaddle-web": "node scripts/check-quaddle-web.mjs",
    "check:practice-sidebars": "node scripts/check-practice-sidebars.cjs",
    "assets:webp": "python3 scripts/convert-images-to-webp.py",
    "assets:webp:check": "python3 scripts/convert-images-to-webp.py --check",
    "dev": "sh scripts/dev.sh",
    "preview": "sh scripts/preview.sh",
    "prepare": "husky",
    "check:simulation": "node scripts/check-simulation.mjs && node scripts/check-simulation-models.mjs && node scripts/check-simulation-worker.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/faster": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@easyops-cn/docusaurus-search-local": "^0.54.1",
    "@mdx-js/react": "^3.0.0",
    "@mujoco/mujoco": "3.16.0",
    "clsx": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "hastscript": "^9.0.1",
    "lucide-react": "^1.14.0",
    "mathjax-full": "^3.2.2",
    "onnxruntime-web": "1.31.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-math": "^6.0.0",
    "three": "^0.186.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "@mixmark-io/domino": "^2.2.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.27",
    "husky": "^9.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": "26.11.1",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0"
}
