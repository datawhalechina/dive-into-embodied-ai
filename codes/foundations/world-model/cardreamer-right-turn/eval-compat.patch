+"""Load optional training replay backends only when requested."""
+from importlib import import_module
 from . import limiters, selectors
 from .generic import Generic
-from .prioritized_experience_replay import PrioritizedExperienceReplay
 from .replays import Uniform
-from .reverb import Reverb
-from .curious_replay import CuriousReplay
-from .adversarial import AdversarialReplay
-from .count_based import CountBasedReplay
+
+_OPTIONAL = {
+    'PrioritizedExperienceReplay': 'prioritized_experience_replay',
+    'Reverb': 'reverb',
+    'CuriousReplay': 'curious_replay',
+    'AdversarialReplay': 'adversarial',
+    'CountBasedReplay': 'count_based',
+}
+
+def __getattr__(name):
+    if name not in _OPTIONAL:
+        raise AttributeError(name)
+    value = getattr(import_module('.' + _OPTIONAL[name], __name__), name)
+    globals()[name] = value
+    return value
